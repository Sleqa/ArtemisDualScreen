<?xml version="1.0" encoding="utf-8"?>
<!-- Fluent accent control: the system accent fill used for primary actions -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33000000">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/win_accent_tertiary" />
                    <corners android:radius="@dimen/win_radius_control" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/win_accent" />
                    <corners android:radius="@dimen/win_radius_control" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
