<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="108dp"
    android:layout_margin="4dp"
    android:background="@drawable/companion_bg_tile_state"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bind_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/companion_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bind_custom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/companion_bg_badge"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="@string/companion_custom"
                android:textColor="@color/companion_on_accent"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/bind_keys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:chipSpacingHorizontal="4dp"
            app:chipSpacingVertical="4dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/bind_edit_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#8C000000"
        android:visibility="gone">

        <ImageView
            android:id="@+id/bind_drag"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical|start"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:src="@drawable/companion_ic_drag"
            android:tint="@color/companion_text_soft" />

        <ImageButton
            android:id="@+id/bind_delete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical|end"
            android:background="@drawable/companion_bg_delete"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/companion_ic_close"
            android:tint="@color/companion_warning" />
    </FrameLayout>
</FrameLayout>
