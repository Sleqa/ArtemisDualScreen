<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <com.limelight.companion.view.TouchpadView
                android:id="@+id/touchpad"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/companion_tab_touchpad" />

            <LinearLayout
                android:id="@+id/touch_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/companion_ic_hand"
                    android:tint="#FF5A5A64" />

                <TextView
                    android:id="@+id/touch_hint_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/companion_touch_hint_relative"
                    android:textColor="@color/companion_text_faint"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/companion_touch_hint_gestures"
                    android:textColor="#FF7A7A84"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:background="@drawable/companion_bg_segment_track"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/mode_relative"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/companion_bg_segment"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/companion_relative"
                    android:textColor="@color/companion_toggle_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mode_absolute"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/companion_bg_segment"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/companion_absolute"
                    android:textColor="@color/companion_toggle_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <com.limelight.companion.view.ScrollStripView
            android:id="@+id/scroll_strip"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="66dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/click_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/companion_bg_button_state"
            android:stateListAnimator="@null"
            android:text="@string/companion_left_click"
            android:textAllCaps="false"
            android:textColor="@color/companion_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/click_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/companion_bg_button_state"
            android:stateListAnimator="@null"
            android:text="@string/companion_right_click"
            android:textAllCaps="false"
            android:textColor="@color/companion_text"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
