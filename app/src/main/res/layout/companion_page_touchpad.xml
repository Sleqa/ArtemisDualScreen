<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <com.limelight.companion.view.TouchpadView
                android:id="@+id/touchpad"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/companion_tab_touchpad" />

            <LinearLayout
                android:id="@+id/touch_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/companion_ic_hand"
                    android:tint="#FF5A5A64" />

                <TextView
                    android:id="@+id/touch_hint_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/companion_touch_hint_relative"
                    android:textColor="@color/companion_text_faint"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/companion_touch_hint_gestures"
                    android:textColor="#FF7A7A84"
                    android:textSize="12sp" />
            </LinearLayout>

        </FrameLayout>

        <com.limelight.companion.view.ScrollStripView
            android:id="@+id/scroll_strip"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp" />
    </LinearLayout>

</LinearLayout>
