<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/companion_bg"
    android:clickable="true"
    android:focusable="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ArtemisDS"
            android:textColor="@color/companion_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/companion_bg_chip"
            android:gravity="center"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:text="@string/companion_not_streaming"
            android:textColor="@color/companion_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/waiting_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:textColor="@color/companion_text"
            android:textSize="88sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:format12Hour="EEEE d MMMM"
            android:format24Hour="EEEE d MMMM"
            android:textColor="@color/companion_text_secondary"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/companion_bg_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <com.limelight.companion.view.BatteryView
                android:id="@+id/waiting_battery_icon"
                android:layout_width="30dp"
                android:layout_height="16dp" />

            <TextView
                android:id="@+id/waiting_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/companion_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/waiting_battery_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/companion_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/companion_waiting_message"
            android:textColor="@color/companion_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/companion_divider" />

    <TextView
        android:id="@+id/waiting_edit_keybinds"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/companion_edit_keybinds"
        android:textColor="@color/companion_text_soft"
        android:textSize="13sp" />
</LinearLayout>
