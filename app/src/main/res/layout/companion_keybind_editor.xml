<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/companion_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/editor_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/companion_cancel"
            android:textColor="@color/companion_text_soft"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/editor_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/companion_new_keybind"
            android:textColor="@color/companion_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/editor_delete"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/companion_delete"
            android:textColor="@color/companion_warning"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/editor_save"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/companion_bg_accent_button"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/companion_save"
            android:textColor="@color/companion_on_accent"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/companion_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/editor_name"
                    android:text="@string/companion_name"
                    android:textColor="@color/companion_text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/editor_name"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/companion_bg_field"
                    android:hint="@string/companion_name_hint"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="24"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/companion_text"
                    android:textColorHint="#FF6E6E78"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/companion_sends"
                    android:textColor="@color/companion_text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/companion_bg_segment_track"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/editor_mode_tap"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/companion_bg_segment"
                        android:gravity="center"
                        android:text="@string/companion_tap"
                        android:textColor="@color/companion_toggle_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/editor_mode_hold"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1.6"
                        android:background="@drawable/companion_bg_segment"
                        android:gravity="center"
                        android:text="@string/companion_hold"
                        android:textColor="@color/companion_toggle_text"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/companion_bg_combo">

            <LinearLayout
                android:id="@+id/editor_combo"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/editor_combo_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/companion_combo_empty"
                android:textColor="@color/companion_text_faint"
                android:textSize="13sp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/editor_mods"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/editor_categories"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/editor_keys"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:overScrollMode="never" />
    </LinearLayout>
</LinearLayout>
