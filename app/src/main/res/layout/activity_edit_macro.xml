<?xml version="1.0" encoding="utf-8"?>
<!-- Macro editor laid out like a Windows 11 settings page: a stack of cards, each holding one
     setting with its label on the left and its control on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/win_solid_background_base"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/win_solid_background_secondary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Icon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_win_card"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/win_ui"
                        android:text="@string/macro_icon_label"
                        android:textColor="@color/win_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/win_ui"
                        android:text="@string/macro_icon_summary"
                        android:textColor="@color/win_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/macroIconPicker"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_win_control"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/macroIconPreview"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/macro_icon_label" />

                    <TextView
                        android:id="@+id/macroIconEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/win_ui"
                        android:gravity="center"
                        android:text="@string/macro_icon_none_glyph"
                        android:textColor="@color/win_text_tertiary"
                        android:textSize="18sp" />
                </FrameLayout>
            </LinearLayout>

            <!-- Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_win_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/win_ui"
                    android:text="@string/macro_name_hint"
                    android:textColor="@color/win_text_primary"
                    android:textSize="14sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/macro_name_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/macroNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/win_ui"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/win_text_primary" />

                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Selected keys -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_win_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/win_ui"
                    android:text="@string/macro_selected_keys_label"
                    android:textColor="@color/win_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/noKeysSelectedText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/win_ui"
                    android:text="@string/macro_no_keys_selected"
                    android:textColor="@color/win_text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/selectedKeysChipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Key picker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_win_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/win_ui"
                    android:text="@string/macro_pick_keys_label"
                    android:textColor="@color/win_text_primary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/keyPickerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
