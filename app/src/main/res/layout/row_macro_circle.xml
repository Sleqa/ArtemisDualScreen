<?xml version="1.0" encoding="utf-8"?>
<!-- One macro rendered as a circular key: its icon (or initials) on the circle, with the
     macro's name underneath. A macro with no name shows just the circle. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <FrameLayout
        android:id="@+id/macroCircle"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_macro_circle"
        android:clickable="true"
        android:focusable="false">

        <TextView
            android:id="@+id/macroInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp" />

        <ImageView
            android:id="@+id/macroIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:visibility="gone"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <TextView
        android:id="@+id/macroLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="2"
        android:textColor="#E6FFFFFF"
        android:textSize="10sp" />
</LinearLayout>
