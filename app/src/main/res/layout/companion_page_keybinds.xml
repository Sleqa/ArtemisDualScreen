<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/keybinds_subline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/companion_keybinds_idle"
            android:textColor="@color/companion_text_faint"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/keybinds_edit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/companion_bg_toggle"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/companion_edit"
            android:textColor="@color/companion_toggle_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/keybinds_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never" />
</LinearLayout>
