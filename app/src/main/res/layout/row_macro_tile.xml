<?xml version="1.0" encoding="utf-8"?>
<!-- One macro as a Windows 11 quick-settings style tile: a 4dp-cornered control carrying the
     macro's icon (or its initials), with the macro's name captioned underneath. A macro with
     no name shows the tile alone. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <FrameLayout
        android:id="@+id/macroCircle"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_win_control"
        android:clickable="true"
        android:focusable="false">

        <TextView
            android:id="@+id/macroInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/win_ui"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/win_text_primary"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/macroIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:visibility="gone"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <TextView
        android:id="@+id/macroLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/win_ui"
        android:gravity="center_horizontal"
        android:maxLines="2"
        android:textColor="@color/win_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
