<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        The app is themed after Windows 11 (Fluent 2): solid dark grounds, layered cards with
        hairline strokes, 8dp surfaces / 4dp controls, the Windows system accent blue, and Inter
        standing in for Segoe UI Variable. Colours live in colors_win.xml, geometry in
        dimens_win.xml.
    -->
    <style name="AppBaseTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:fontFamily">@font/win_ui</item>
        <item name="fontFamily">@font/win_ui</item>

        <item name="colorPrimary">@color/win_accent</item>
        <item name="colorPrimaryDark">@color/win_solid_background_secondary</item>
        <item name="colorSecondary">@color/win_accent</item>
        <item name="colorAccent">@color/win_accent</item>
        <item name="colorOnPrimary">@color/win_text_on_accent</item>
        <item name="colorSurface">@color/win_card_fill</item>
        <item name="colorOnSurface">@color/win_text_primary</item>
        <item name="android:textColorPrimary">@color/win_text_primary</item>
        <item name="android:textColorSecondary">@color/win_text_secondary</item>
        <item name="android:textColorTertiary">@color/win_text_tertiary</item>
        <item name="android:textColorHint">@color/win_text_tertiary</item>
        <item name="colorControlNormal">@color/win_text_secondary</item>
        <item name="colorControlActivated">@color/win_accent</item>
        <item name="colorControlHighlight">@color/win_control_ripple</item>
    </style>

    <!-- Application theme. -->
    <style name="AppTheme" parent="AppBaseTheme">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/win_solid_background_base</item>
        <item name="android:navigationBarColor">@color/win_solid_background_base</item>
        <item name="android:colorBackground">@color/win_solid_background_base</item>
        <item name="android:windowBackground">@color/win_solid_background_base</item>
        <item name="alertDialogTheme">@style/Theme.Win.Dialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.Win.Dialog</item>
    </style>

    <style name="StreamBaseTheme" parent="AppBaseTheme">
        <!-- Transparent streaming background to avoid extra overdraw -->
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Stream activity theme -->
    <style name="StreamTheme" parent="StreamBaseTheme">
        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Added for API 34+ where ImageButton requires these color attrs to inflate -->
        <item name="android:colorControlNormal">@android:color/white</item>
        <item name="android:colorControlHighlight">@android:color/white</item>
        <item name="android:colorAccent">@android:color/white</item>
        <item name="android:colorControlActivated">@android:color/white</item>
        <item name="android:colorButtonNormal">@android:color/white</item>
        <!-- Duplicate non-prefixed color attributes for AppCompat widgets -->
        <item name="colorControlNormal">@android:color/white</item>
        <item name="colorControlHighlight">@android:color/white</item>
        <item name="colorAccent">@android:color/white</item>
        <item name="colorControlActivated">@android:color/white</item>
        <item name="colorButtonNormal">@android:color/white</item>
    </style>

    <style name="SettingsTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">@font/win_ui</item>
        <item name="fontFamily">@font/win_ui</item>
        <item name="colorAccent">@color/win_accent</item>
        <item name="colorControlActivated">@color/win_accent</item>
        <item name="colorControlHighlight">@color/win_control_ripple</item>
        <item name="android:textColorPrimary">@color/win_text_primary</item>
        <item name="android:textColorSecondary">@color/win_text_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Used by the macro editor screens (MacroListActivity/EditMacroActivity), which need a
         Theme.MaterialComponents ancestor for Material Chip/TextInputLayout to inflate safely -
         SettingsTheme (Theme.AppCompat.NoActionBar) does not satisfy that requirement. -->
    <style name="MacroEditorTheme" parent="AppBaseTheme">
        <item name="android:statusBarColor">@color/win_solid_background_secondary</item>
        <item name="android:navigationBarColor">@color/win_solid_background_base</item>
        <item name="android:colorBackground">@color/win_solid_background_base</item>
        <item name="android:windowBackground">@color/win_solid_background_base</item>
        <item name="alertDialogTheme">@style/Theme.Win.Dialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.Win.Dialog</item>
    </style>

    <style name="ExternalDisplayControllerTheme" parent="AppTheme">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Fluent flyout: rounded 8dp surface, layer fill, accent text buttons -->
    <style name="Theme.Win.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:fontFamily">@font/win_ui</item>
        <item name="fontFamily">@font/win_ui</item>
        <item name="android:background">@color/win_layer_fill</item>
        <item name="android:windowBackground">@drawable/bg_win_surface</item>
        <item name="android:textColorPrimary">@color/win_text_primary</item>
        <item name="android:textColorSecondary">@color/win_text_secondary</item>
        <item name="colorAccent">@color/win_accent</item>
        <item name="colorControlActivated">@color/win_accent</item>
        <item name="colorControlHighlight">@color/win_control_ripple</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Win.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Win.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Win.DialogButton</item>
    </style>

    <style name="Widget.Win.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/win_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/win_ui</item>
    </style>

    <!-- Standard Fluent button: 4dp corners, control fill, hairline stroke, sentence case -->
    <style name="Widget.Win.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_win_control</item>
        <item name="android:textColor">@color/win_text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/win_text_body</item>
        <item name="android:fontFamily">@font/win_ui</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Win.Button.Accent">
        <item name="android:background">@drawable/bg_win_accent_control</item>
        <item name="android:textColor">@color/win_text_on_accent</item>
    </style>

    <style name="TextAppearance.Win.Title" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/win_ui</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/win_text_primary</item>
    </style>

    <style name="TextAppearance.Win.Subtitle" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/win_ui</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">@dimen/win_text_subtitle</item>
        <item name="android:textColor">@color/win_text_primary</item>
    </style>

    <style name="TextAppearance.Win.Body" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/win_ui</item>
        <item name="android:textSize">@dimen/win_text_body</item>
        <item name="android:textColor">@color/win_text_primary</item>
    </style>

    <style name="TextAppearance.Win.Caption" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/win_ui</item>
        <item name="android:textSize">@dimen/win_text_caption</item>
        <item name="android:textColor">@color/win_text_secondary</item>
    </style>

    <declare-styleable name="ApertureViewGroup">
        <attr name="aperture_color1" format="color" />
        <attr name="aperture_color2" format="color" />
        <attr name="aperture_border_width" format="dimension" />
        <attr name="aperture_border_angle" format="dimension" />
        <attr name="aperture_duration" format="integer" />
        <attr name="aperture_middle_color" format="color" />
    </declare-styleable>

</resources>
